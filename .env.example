# Bhasha Bench reads SARVAM_API_KEY from the environment only.
#
# Copy this file to .env (gitignored), put your key on the line below, then
# load it into your shell before running:
#
#     set -a; source .env; set +a
#
# Never commit .env. Never paste the key into a chat, a screenshot or a log.
SARVAM_API_KEY=
